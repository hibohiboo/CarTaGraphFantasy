{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "docs/plans",
  "autoMemoryEnabled": true,
  "language": "japanese",
  "permissions": {
    "allow": ["Bash(git diff *)", "Bash(git log *)", "Bash(git show *)", "Bash(git status)"],
    "deny": ["Read(.env)", "Read(.env.*)"]
  }
}
