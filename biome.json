{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!docs/.vitepress/cache",
      "!docs/.vitepress/dist",
      "!docs/public/preview",
      "!apps/web/public/mockServiceWorker.js",
      "!pnpm-lock.yaml",
      "!.claude/skills/react-best-practices"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noNestedComponentDefinitions": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error",
        "noImportCycles": "error"
      }
    },
    "domains": {
      "test": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "error",
            "noReExportAll": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "./../**", "@cartagraph/domain", "@cartagraph/domain/**"],
                    "message": "表に無いディレクトリ はほかのディレクトリを import しない（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/check/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "./../**", "@cartagraph/domain", "@cartagraph/domain/**"],
                    "message": "check/ はほかのディレクトリを import しない（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/user/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "./../**", "@cartagraph/domain", "@cartagraph/domain/**"],
                    "message": "user/ はほかのディレクトリを import しない（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/card/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "./../**",
                      "@cartagraph/domain",
                      "@cartagraph/domain/**",
                      "!../check/**",
                      "!./../check/**"
                    ],
                    "message": "card/ が import してよい先は check/ だけ（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/library/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "./../**",
                      "@cartagraph/domain",
                      "@cartagraph/domain/**",
                      "!../card/**",
                      "!./../card/**",
                      "!../check/**",
                      "!./../check/**"
                    ],
                    "message": "library/ が import してよい先は card/・check/ だけ（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/character/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "./../**",
                      "@cartagraph/domain",
                      "@cartagraph/domain/**",
                      "!../card/**",
                      "!./../card/**",
                      "!../check/**",
                      "!./../check/**"
                    ],
                    "message": "character/ が import してよい先は card/・check/ だけ（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/autoCombat/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "./../**",
                      "@cartagraph/domain",
                      "@cartagraph/domain/**",
                      "!../character/**",
                      "!./../character/**",
                      "!../card/**",
                      "!./../card/**",
                      "!../check/**",
                      "!./../check/**"
                    ],
                    "message": "autoCombat/ が import してよい先は character/・card/・check/ だけ（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/scenario/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "./../**",
                      "@cartagraph/domain",
                      "@cartagraph/domain/**",
                      "!../autoCombat/**",
                      "!./../autoCombat/**",
                      "!../character/**",
                      "!./../character/**",
                      "!../card/**",
                      "!./../card/**",
                      "!../check/**",
                      "!./../check/**"
                    ],
                    "message": "scenario/ が import してよい先は autoCombat/・character/・card/・check/ だけ（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/session/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "./../**",
                      "@cartagraph/domain",
                      "@cartagraph/domain/**",
                      "!../scenario/**",
                      "!./../scenario/**",
                      "!../autoCombat/**",
                      "!./../autoCombat/**",
                      "!../character/**",
                      "!./../character/**",
                      "!../card/**",
                      "!./../card/**",
                      "!../check/**",
                      "!./../check/**"
                    ],
                    "message": "session/ が import してよい先は scenario/・autoCombat/・character/・card/・check/ だけ（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/soloVillage/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "./../**",
                      "@cartagraph/domain",
                      "@cartagraph/domain/**",
                      "!../session/**",
                      "!./../session/**",
                      "!../scenario/**",
                      "!./../scenario/**",
                      "!../autoCombat/**",
                      "!./../autoCombat/**",
                      "!../character/**",
                      "!./../character/**",
                      "!../card/**",
                      "!./../card/**",
                      "!../check/**",
                      "!./../check/**"
                    ],
                    "message": "soloVillage/ が import してよい先は session/・scenario/・autoCombat/・character/・card/・check/ だけ（docs/process/rules/architecture.md「packages/domain の中の置き場所」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "error",
            "noReExportAll": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/mocks", "@/mocks/**", "@/test", "@/test/**", "../**", "./../**"],
                    "message": "app は層の外（mocks・test）を import しない。ほかの層は @/<層>/… で import する（docs/process/rules/architecture.md「依存の向き」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/mocks",
                      "@/mocks/**",
                      "@/test",
                      "@/test/**",
                      "../../**",
                      "./../../**"
                    ],
                    "message": "pages が import してよいのは下の層（widgets・features・entities・shared）だけ。同じ層の別スライスは import しない。スライスの外は @/<層>/…、中は相対パス（docs/process/rules/architecture.md「依存の向き」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/widgets",
                      "@/widgets/**",
                      "@/mocks",
                      "@/mocks/**",
                      "@/test",
                      "@/test/**",
                      "../../**",
                      "./../../**"
                    ],
                    "message": "widgets が import してよいのは下の層（features・entities・shared）だけ。同じ層の別スライスは import しない。スライスの外は @/<層>/…、中は相対パス（docs/process/rules/architecture.md「依存の向き」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/widgets",
                      "@/widgets/**",
                      "@/features",
                      "@/features/**",
                      "@/mocks",
                      "@/mocks/**",
                      "@/test",
                      "@/test/**",
                      "../../**",
                      "./../../**"
                    ],
                    "message": "features が import してよいのは下の層（entities・shared）だけ。同じ層の別スライスは import しない。スライスの外は @/<層>/…、中は相対パス（docs/process/rules/architecture.md「依存の向き」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/widgets",
                      "@/widgets/**",
                      "@/features",
                      "@/features/**",
                      "@/entities",
                      "@/entities/**",
                      "@/mocks",
                      "@/mocks/**",
                      "@/test",
                      "@/test/**",
                      "../../**",
                      "./../../**"
                    ],
                    "message": "entities が import してよいのは下の層（shared）だけ。同じ層の別スライスは import しない。スライスの外は @/<層>/…、中は相対パス（docs/process/rules/architecture.md「依存の向き」）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/widgets",
                      "@/widgets/**",
                      "@/features",
                      "@/features/**",
                      "@/entities",
                      "@/entities/**",
                      "@/shared",
                      "@/shared/**",
                      "@/mocks",
                      "@/mocks/**",
                      "@/test",
                      "@/test/**",
                      "../../**",
                      "./../../**"
                    ],
                    "message": "shared はほかの層を import しない。shared の中は相対パスで import する（docs/process/rules/architecture.md「依存の向き」）"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
