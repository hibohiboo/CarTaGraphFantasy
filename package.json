{
  "name": "cartagraph-fantasy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/check-doc-anchors.mjs && node scripts/check-terms.mjs && node scripts/check-screens.mjs && node scripts/check-spec-paths.mjs && node scripts/check-provisional.mjs && node scripts/check-suppressions.mjs && node scripts/check-biome-layers.mjs && node scripts/sync-claude-rules.mjs --check",
    "docs:preview": "vitepress preview docs",
    "web:dev": "pnpm --filter @cartagraph/web dev",
    "web:dev:agent": "pnpm --filter @cartagraph/web dev --port 5174",
    "web:dev:agent:stop": "node scripts/stop-dev-agent.mjs",
    "web:build": "pnpm --filter @cartagraph/web build",
    "web:test": "pnpm --filter @cartagraph/web test",
    "web:e2e": "pnpm --filter @cartagraph/web e2e",
    "web:check:publish": "pnpm --filter @cartagraph/web check:publish",
    "web:check:authoring": "pnpm --filter @cartagraph/web check:authoring",
    "web:check:character": "pnpm --filter @cartagraph/web check:character",
    "web:typecheck": "pnpm --filter @cartagraph/web typecheck",
    "domain:test": "pnpm --filter @cartagraph/domain test",
    "domain:typecheck": "pnpm --filter @cartagraph/domain typecheck",
    "schemas:test": "pnpm --filter @cartagraph/schemas test",
    "schemas:typecheck": "pnpm --filter @cartagraph/schemas typecheck",
    "tools:test": "node --test \"scripts/*.test.mjs\" \".claude/hooks/*.test.mjs\"",
    "sim:auto-combat": "tsx scripts/simulate-auto-combat.ts",
    "build:pages": "pnpm run docs:build && pnpm run web:build && node scripts/copy-web-to-pages.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "mermaid": "^11.17.2",
    "tsx": "^4.23.15",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
